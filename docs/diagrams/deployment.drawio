<mxfile host="drawio"><diagram id="d" name="Deployment"><mxGraphModel grid="0" page="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Deployment in one network: the Helm chart in helm/ (OpenShift)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Defaults from helm/values.yaml. Dashed parts exist only with collector.enabled=true. One values file per network (helm/networks/&amp;lt;network&amp;gt;.yaml) sets domain, and if needed image.tag or route.host. Checksum annotations restart the pod when config, secrets, files or the collector config change." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Manager&lt;/b&gt;&lt;br&gt;through NGINX and DataPower&lt;br&gt;(HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Route&lt;/b&gt; cluster-client&lt;br&gt;host: route.host or&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;cluster-client.&amp;lt;domain&amp;gt;&lt;/font&gt;&lt;br&gt;TLS edge, http redirected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="300" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Service&lt;/b&gt; cluster-client&lt;br&gt;port 80 (service.port)&lt;br&gt;→ targetPort http" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="260" height="110" as="geometry"/></mxCell><mxCell id="c8" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Pod&lt;/b&gt; (Deployment, replicaCount 1) · runAsNonRoot · seccomp RuntimeDefault · no service account token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#333333;fontSize=15;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1620" height="800" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;container cluster-client&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;artifactory.&amp;lt;domain&amp;gt;/cluster-client:&amp;lt;image.tag or appVersion&amp;gt;&lt;/font&gt;&lt;br&gt;python entrypoint.py → Settings() from env · port http 8000 (containerPort)&lt;br&gt;read-only root filesystem · no privilege escalation · all capabilities dropped&lt;br&gt;probes: GET /health/live, GET /health/ready (open, no access check)&lt;br&gt;&lt;br&gt;&lt;b&gt;envFrom&lt;/b&gt;&lt;br&gt;• ConfigMap cluster-client ← values &lt;b&gt;config&lt;/b&gt; (&lt;font face=&quot;Courier New&quot;&gt;CLUSTER_CLIENT_LOG__LEVEL=INFO&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;LOG__CONSOLE__FORMAT=json&lt;/font&gt;, ...)&lt;br&gt;• Secret cluster-client ← values &lt;b&gt;secret&lt;/b&gt; (required: &lt;font face=&quot;Courier New&quot;&gt;CLUSTER_CLIENT_ACCESS__USERNAME&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;..._PASSWORD&lt;/font&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;env set by the chart&lt;/b&gt; (env wins over envFrom, so values.schema.json forbids these keys in config/secret)&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;SERVER__PORT&lt;/font&gt; ← containerPort · &lt;font face=&quot;Courier New&quot;&gt;SERVER__HOST=0.0.0.0&lt;/font&gt; comes from the image&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;VALIDATION__SCHEMA_PATH, __IGNORED_FIELDS_PATH, __REDACTED_FIELDS_PATH&lt;/font&gt; ← files.*&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;LOG__FILE__PATH, LOG__FAILURE_FILE__PATH&lt;/font&gt; ← logs.directory + logs.app / logs.failures&lt;br&gt;• with the collector: &lt;font face=&quot;Courier New&quot;&gt;LOG__LEVEL&lt;/font&gt; ← collector.logLevel (DEBUG), &lt;font face=&quot;Courier New&quot;&gt;LOG__FILE__ENABLED=true&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;LOG__FILE__FORMAT=json&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;TELEMETRY__EXPORT_ENABLED=true&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;OTLP_ENDPOINT=http://127.0.0.1:4318&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="760" height="420" as="geometry"/></mxCell><mxCell id="c12" value="http" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;container collector&lt;/b&gt; (optional)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;artifactory.&amp;lt;domain&amp;gt;/otel/opentelemetry-collector-contrib:0.164.0&lt;/font&gt;&lt;br&gt;--config=/etc/otelcol/config.yaml · read-only root filesystem&lt;br&gt;&lt;br&gt;&lt;b&gt;receivers&lt;/b&gt;&lt;br&gt;• file_log: reads &lt;font face=&quot;Courier New&quot;&gt;/app/logs/app.log&lt;/font&gt; (JSON lines), from the start, offset kept in file_storage&lt;br&gt;• otlp http on &lt;font face=&quot;Courier New&quot;&gt;127.0.0.1:4318&lt;/font&gt;: the service&#x27;s spans&lt;br&gt;&lt;br&gt;&lt;b&gt;processors&lt;/b&gt;&lt;br&gt;• resource: service.name=cluster-client, data_stream.dataset=cluster_client&lt;br&gt;• batch&lt;br&gt;&lt;br&gt;&lt;b&gt;exporter&lt;/b&gt;&lt;br&gt;• elasticsearch: endpoint, user, password from env&lt;br&gt;&amp;nbsp;&amp;nbsp;ELASTIC_ENDPOINT ← collector.elasticsearch.endpoint&lt;br&gt;&amp;nbsp;&amp;nbsp;ELASTIC_USERNAME / PASSWORD ← Secret cluster-client-collector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="540" height="420" as="geometry"/></mxCell><mxCell id="c14" value="spans, OTLP http" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;volume files&lt;/b&gt; ← ConfigMap cluster-client-files&lt;br&gt;(every helm/files/*.json, as is)&lt;br&gt;mounted read-only, one file per path (subPath):&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;/etc/cluster-client/response-schema.json&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;/etc/cluster-client/ignored-fields.json&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;/etc/cluster-client/redacted-fields.json&lt;/font&gt;&lt;br&gt;paths: files.schema, files.ignoredFields, files.redactedFields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="480" height="240" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;volume logs&lt;/b&gt; (emptyDir, logsSizeLimit 512Mi)&lt;br&gt;mounted at logs.directory &lt;font face=&quot;Courier New&quot;&gt;/app/logs&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;app.log&lt;/font&gt;: every line, JSON (written only&lt;br&gt;&amp;nbsp;&amp;nbsp;with the collector or LOG__FILE__ENABLED)&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;failures.log&lt;/font&gt;: one JSON line per failure&lt;br&gt;read-write for the service, read-only for the collector.&lt;br&gt;Lost when the pod goes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="580" y="830" width="420" height="240" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;volume collector-state&lt;/b&gt;&lt;br&gt;(emptyDir)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/var/lib/otelcol/file_storage&lt;/font&gt;&lt;br&gt;how far app.log was read, so a collector restart sends no line twice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="830" width="260" height="240" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;volume collector&lt;/b&gt;&lt;br&gt;← ConfigMap cluster-client-collector&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/etc/otelcol/config.yaml&lt;/font&gt;&lt;br&gt;(read-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1340" y="830" width="260" height="240" as="geometry"/></mxCell><mxCell id="c19" value="read at startup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.31;entryY=1;" edge="1" parent="1" source="c15" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="reads app.log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;entryX=0;entryY=0.9;" edge="1" parent="1" source="c16" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="958" y="805"/><mxPoint x="1030" y="805"/><mxPoint x="1030" y="738"/></Array></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.55;entryY=1;" edge="1" parent="1" source="c17" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Elasticsearch&lt;/b&gt; (outside the pod)&lt;br&gt;collector.elasticsearch.endpoint&lt;br&gt;&lt;br&gt;data streams, the same in every network:&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;logs-cluster_client.otel-default&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;traces-cluster_client.otel-default&lt;/font&gt;&lt;br&gt;&lt;br&gt;The service itself never talks to Elastic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1700" y="360" width="400" height="300" as="geometry"/></mxCell><mxCell id="c25" value="logs + traces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c13" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Targets&lt;/b&gt;&lt;br&gt;Redis Enterprise clusters in this network&lt;br&gt;(any URL the manager names in x-edge-url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1700" y="130" width="400" height="140" as="geometry"/></mxCell><mxCell id="c27" value="requests, verify=False" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.06;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="385"/><mxPoint x="1000" y="200"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>