<mxfile host="drawio"><diagram id="d" name="Modules"><mxGraphModel grid="0" page="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;app/: every module, its public functions, models, errors and settings&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2400" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Rows are the import layers of pyproject.toml (lint-imports): a module imports only from rows below it; modules in one row never import each other. The rules/ package spans four rows: its own contract orders response_rules → schema | schema_limits → field_paths → json_reading. Every package has an empty __init__.py." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2400" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;main | server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="200" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;app/main.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;create_app(settings) → FastAPI&lt;br&gt;excluded_urls(paths)&lt;br&gt;lifespan(app): logging, telemetry,&lt;br&gt;&amp;nbsp;&amp;nbsp;load_rules, check_own_answers&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="410" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;app/server.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;serve(app, settings) → uvicorn.run&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="110" width="410" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;routes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="200" height="190" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;routes/target_routes.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;build_target_router(settings)&lt;br&gt;require_access(request)&amp;nbsp;&amp;nbsp;[dependency]&lt;br&gt;target_endpoint(request, body)&amp;nbsp;&amp;nbsp;POST /&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="285" width="410" height="190" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;routes/read_request.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;read_body(request)&amp;nbsp;&amp;nbsp;[async]&lt;br&gt;read_target_request(headers, body, settings)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ TargetRequest&lt;br&gt;header_of_field(settings)&lt;br&gt;named_by_header(error, headers_by_field)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="285" width="410" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;routes/target_openapi.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;BasicAuthDocumentation (docs only)&lt;br&gt;failure_responses, documented_failure&lt;br&gt;request_documentation, forwarding_rule&lt;br&gt;target_request_headers&lt;br&gt;documented_target_headers&lt;br&gt;trace_request_header, trace_response_header&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1100" y="285" width="410" height="190" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;routes/health_routes.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;health_router&lt;br&gt;report_alive&amp;nbsp;&amp;nbsp;GET /health/live&lt;br&gt;report_ready&amp;nbsp;&amp;nbsp;GET /health/ready&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1530" y="285" width="410" height="190" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;failures | target | telemetry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="200" height="170" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;failures/answers.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;failed_request_answer(...) → Answer&lt;br&gt;failure_code, failure_codes&lt;br&gt;failure_record → FailureRecord&lt;br&gt;redacted_content&lt;br&gt;logged_answer: log + build the answer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="500" width="410" height="170" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;failures/body.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;failure_body → FailureBody&lt;br&gt;reason_parts (cut to part_length,&lt;br&gt;&amp;nbsp;&amp;nbsp;max_parts)&lt;br&gt;shortened_field (... prefix)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="500" width="410" height="170" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;failures/exception_handlers.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;refused_request_response&amp;nbsp;&amp;nbsp;400/404/405&lt;br&gt;access_denied_response&amp;nbsp;&amp;nbsp;401&lt;br&gt;internal_error_response&amp;nbsp;&amp;nbsp;500&lt;br&gt;own_failure_answer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1100" y="500" width="410" height="170" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;failures/own_answers_check.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;check_own_answers(rules, settings)&lt;br&gt;too_long, sample_details&lt;br&gt;schema_problems&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1530" y="500" width="410" height="170" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;target/response_builder.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;build_response(target_response,&lt;br&gt;&amp;nbsp;&amp;nbsp;rules, settings) → Answer&lt;br&gt;too_deep&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1960" y="500" width="410" height="170" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;target/client.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;send_to_target(request, settings)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ Answer (thread, total timeout)&lt;br&gt;call_target → requests.request&lt;br&gt;classified_error, was_not_sent&lt;br&gt;returned_headers&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2390" y="500" width="410" height="170" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;telemetry.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;build_tracer_provider&lt;br&gt;start_telemetry&lt;br&gt;stop_telemetry&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2820" y="500" width="410" height="170" as="geometry"/></mxCell><mxCell id="c_state_row" value="&lt;b&gt;state&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="695" width="200" height="125" as="geometry"/></mxCell><mxCell id="c_state_box" value="&lt;b&gt;state.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;settings_of(state) → Settings&lt;br&gt;rules_of(state) → ResponseRules&lt;br&gt;tracer_provider_of(state) → TracerProvider&lt;br&gt;the one place that reads app.state, typed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="695" width="410" height="125" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;access | rules&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="845" width="200" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;access.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;check_access(header_value, settings)&lt;br&gt;expected_credentials&amp;nbsp;&amp;nbsp;(not logged)&lt;br&gt;login_challenge → www-authenticate&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="845" width="410" height="150" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;rules/response_rules.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;ResponseRules: schema_validator,&lt;br&gt;&amp;nbsp;&amp;nbsp;ignored_fields, redacted_fields,&lt;br&gt;&amp;nbsp;&amp;nbsp;error_limits&lt;br&gt;load_rules(settings) → ResponseRules&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="845" width="410" height="150" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;inside rules/: schema | schema_limits&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="200" height="170" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;rules/schema.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;load_schema(path) → Validator&lt;br&gt;validate_body (raises ResponseRejectedError)&lt;br&gt;violation_at, every_error&lt;br&gt;first_violation&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="1020" width="410" height="170" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;rules/schema_limits.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;error_body_limits(schema, path)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ ErrorBodyLimits&lt;br&gt;smallest_limit, nodes_at&lt;br&gt;with_alternatives, referenced, children&lt;br&gt;property_schemas, item_schemas, schema_list&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="1020" width="410" height="170" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;inside rules/: field_paths&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1215" width="200" height="170" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;rules/field_paths.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;FieldPath = tuple[str, ...]&lt;br&gt;load_field_paths(path)&lt;br&gt;parse_field_path(field, path)&lt;br&gt;remove_fields(body, field_paths)&lt;br&gt;without_field, without_field_in_items&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="1215" width="410" height="170" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;models | inside rules/: json_reading&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1410" width="200" height="210" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;models.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;FrozenModel&lt;br&gt;TargetRequest(method, url, headers, body)&lt;br&gt;Answer(status_code, headers, content)&lt;br&gt;FailureBody(error, rule, field, reason[])&lt;br&gt;FailureDetails → FailureRecord&lt;br&gt;ErrorBodyLimits, HealthStatus&lt;br&gt;checked_http_url&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="1410" width="410" height="210" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;rules/json_reading.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;read_json_file(path, error)&lt;br&gt;read_json_body(content)&amp;nbsp;&amp;nbsp;(no NaN)&lt;br&gt;refuse_constant&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="1410" width="410" height="210" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;logger&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1645" width="200" height="110" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;logger/decorators.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;log_debug, log_info(inputs, outputs)&lt;br&gt;wrap_call, pick_inputs, read_path&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="1645" width="410" height="110" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;logger/setup.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;configure_logging(settings)&lt;br&gt;reset_logging, install&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="1645" width="410" height="110" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;logger/handlers.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;console_handler, file_handler&lt;br&gt;prepare_handler&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1100" y="1645" width="410" height="110" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;logger/formatters.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;JsonFormatter, build_formatter&lt;br&gt;payload_of, trace_fields_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1530" y="1645" width="410" height="110" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;logger/quiet.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;QuietPathsMiddleware&lt;br&gt;QuietRequestFilter, quiet_request&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1960" y="1645" width="410" height="110" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;errors | config&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1780" width="200" height="270" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;errors.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;ClusterClientError&lt;br&gt;├ ConfigFileLoadError: SchemaLoadError,&lt;br&gt;│&amp;nbsp;&amp;nbsp; FieldPathsLoadError&lt;br&gt;├ NonStandardJsonError (ValueError)&lt;br&gt;├ AccessDeniedError&lt;br&gt;└ RequestFailedError(reason, field, rule)&lt;br&gt;&amp;nbsp;&amp;nbsp; ├ TargetUnreachableError:&lt;br&gt;&amp;nbsp;&amp;nbsp; │&amp;nbsp;&amp;nbsp; ConnectionFailedError, NoResponseError&lt;br&gt;&amp;nbsp;&amp;nbsp; ├ InvalidTargetRequestError&lt;br&gt;&amp;nbsp;&amp;nbsp; └ ResponseRejectedError&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="240" y="1780" width="410" height="270" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;config/settings.py&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;Settings (the only BaseSettings, env&lt;br&gt;&amp;nbsp;&amp;nbsp;CLUSTER_CLIENT_*, nested __, .env)&lt;br&gt;&amp;nbsp;&amp;nbsp;own_headers_keep_their_prefixes&lt;br&gt;NoEnvFileSettings (no .env)&lt;br&gt;sections: server, application, access,&lt;br&gt;&amp;nbsp;&amp;nbsp;headers, validation, forwarding,&lt;br&gt;&amp;nbsp;&amp;nbsp;failures, log, telemetry&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="670" y="1780" width="410" height="270" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;config/ sections&lt;/b&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;base.py: BaseConfig (frozen, extra=forbid)&lt;br&gt;field_types.py: HeaderName, LogLevel, Port...&lt;br&gt;constants.py: TEXT_ENCODING, ...&lt;br&gt;access.py AccessSettings&lt;br&gt;headers.py HeaderSettings&lt;br&gt;forwarding.py ForwardingSettings&lt;br&gt;failures.py FailureCode, FailureSettings&lt;br&gt;validation.py ValidationSettings&lt;br&gt;logging.py LoggingSettings, ...&lt;br&gt;server, application, telemetry&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1100" y="1780" width="410" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>