{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "cluster-relay response body (depth levels)",
  "anyOf": [
    {
      "$ref": "#/definitions/level_1"
    }
  ],
  "definitions": {
    "level_1": {
      "description": "level 1: object | array (a list of databases/users/roles/acls/shards, or one object (cluster 175, bdb 172))",
      "type": [
        "object",
        "array"
      ],
      "minProperties": 0,
      "maxProperties": 300,
      "patternProperties": {
        "^[A-Za-z0-9_-]{1,64}$": {
          "$ref": "#/definitions/level_2"
        }
      },
      "additionalProperties": false,
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/level_2"
      },
      "additionalItems": false
    },
    "level_2": {
      "description": "level 2: object | array | string | number | boolean | null (stats intervals (140), shard_list up to 80 (40 shards x 2), bdb inside a list (172), ssh key 380, version maps)",
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "minLength": 0,
      "maxLength": 512,
      "minimum": -1,
      "maximum": 1000000000000000,
      "minProperties": 0,
      "maxProperties": 300,
      "patternProperties": {
        "^[A-Za-z0-9_.-]{1,64}$": {
          "$ref": "#/definitions/level_3"
        }
      },
      "additionalProperties": false,
      "minItems": 0,
      "maxItems": 500,
      "items": {
        "$ref": "#/definitions/level_3"
      },
      "additionalItems": false
    },
    "level_3": {
      "description": "level 3: object | array | string | number | boolean | null (stats intervals in a list (140), shard_list of a bdb in a list, acl rules in a list, stats entries (51), version maps)",
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "minLength": 0,
      "maxLength": 512,
      "minimum": -1,
      "maximum": 1000000000000000,
      "minProperties": 0,
      "maxProperties": 100,
      "patternProperties": {
        "^[A-Za-z0-9_.-]{1,64}$": {
          "$ref": "#/definitions/level_4"
        }
      },
      "additionalProperties": false,
      "minItems": 0,
      "maxItems": 500,
      "items": {
        "$ref": "#/definitions/level_4"
      },
      "additionalItems": false
    },
    "level_4": {
      "description": "level 4: object | array | string | number | boolean | null (stats entries in a list (51), role resource uids, alert values (missing < 0))",
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "minLength": 0,
      "maxLength": 256,
      "minimum": -1000000000000000,
      "maximum": 1000000000000000,
      "minProperties": 0,
      "maxProperties": 100,
      "patternProperties": {
        "^[A-Za-z0-9_-]{1,64}$": {
          "$ref": "#/definitions/level_5"
        }
      },
      "additionalProperties": false,
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/level_5"
      },
      "additionalItems": false
    },
    "level_5": {
      "description": "level 5: object | array | string | number | boolean | null (role resource uids in a list, crdb instances, node alert values)",
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "minLength": 0,
      "maxLength": 256,
      "minimum": -1000000000000000,
      "maximum": 1000000000000000,
      "minProperties": 0,
      "maxProperties": 32,
      "patternProperties": {
        "^[A-Za-z0-9_-]{1,64}$": {
          "$ref": "#/definitions/level_6"
        }
      },
      "additionalProperties": false,
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/level_6"
      },
      "additionalItems": false
    },
    "level_6": {
      "description": "level 6: object | string | number (crdb instance and its db_config)",
      "type": [
        "object",
        "string",
        "number"
      ],
      "minLength": 0,
      "maxLength": 256,
      "minimum": 0,
      "maximum": 10000000000000,
      "minProperties": 0,
      "maxProperties": 100,
      "patternProperties": {
        "^[A-Za-z0-9_-]{1,64}$": {
          "$ref": "#/definitions/level_7"
        }
      },
      "additionalProperties": false
    },
    "level_7": {
      "description": "level 7: object | array | string | number | boolean (crdb instance cluster, module_list)",
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean"
      ],
      "minLength": 0,
      "maxLength": 256,
      "minimum": 0,
      "maximum": 10000000000000,
      "minProperties": 0,
      "maxProperties": 32,
      "patternProperties": {
        "^[A-Za-z0-9_-]{1,64}$": {
          "$ref": "#/definitions/level_8"
        }
      },
      "additionalProperties": false,
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/level_8"
      },
      "additionalItems": false
    },
    "level_8": {
      "description": "level 8: object | string (module entry, credentials; roles_permissions entries in a crdb list)",
      "type": [
        "object",
        "string"
      ],
      "minLength": 0,
      "maxLength": 256,
      "minProperties": 0,
      "maxProperties": 16,
      "patternProperties": {
        "^[A-Za-z0-9_-]{1,64}$": {
          "$ref": "#/definitions/level_9"
        }
      },
      "additionalProperties": false
    },
    "level_9": {
      "description": "level 9: string | number (module name, username, password; role_uid and redis_acl_uid in a crdb list)",
      "type": [
        "string",
        "number"
      ],
      "minLength": 0,
      "maxLength": 128,
      "minimum": 0,
      "maximum": 10000000
    }
  }
}
