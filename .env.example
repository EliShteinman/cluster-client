# Read by Settings() (docker/entrypoint.py and the container). run_local.py ignores this file.
# A real environment variable wins over a line here. Every setting, with its default: docs/configuration.md

# Required: the manager's credentials. NGINX sends `authorization: Basic base64(username:password)`;
# put the plain values here. The username must not contain ":".
CLUSTER_CLIENT_ACCESS__USERNAME=
CLUSTER_CLIENT_ACCESS__PASSWORD=

# Optional: logs (shown with their defaults)
# Lowest level written anywhere. DEBUG logs every call with its data, the target's password included.
CLUSTER_CLIENT_LOG__LEVEL=INFO
# Terminal: INFO and up, `line` or `json` (Helm sets json)
CLUSTER_CLIENT_LOG__CONSOLE__LEVEL=INFO
CLUSTER_CLIENT_LOG__CONSOLE__FORMAT=line
# Main file logs/app.log (JSON, its own level DEBUG): off. To get the full DEBUG log, turn it on
# and set CLUSTER_CLIENT_LOG__LEVEL=DEBUG as well.
CLUSTER_CLIENT_LOG__FILE__ENABLED=false
# Failure file logs/failures.log: one JSON line per failure, the whole error
CLUSTER_CLIENT_LOG__FAILURE_FILE__ENABLED=true

# Optional: the three runtime files (the defaults are relative to the repository root;
# the image sets /etc/cluster-client/<file>.json)
CLUSTER_CLIENT_VALIDATION__SCHEMA_PATH=helm/files/response-schema.json
CLUSTER_CLIENT_VALIDATION__IGNORED_FIELDS_PATH=helm/files/ignored-fields.json
CLUSTER_CLIENT_VALIDATION__REDACTED_FIELDS_PATH=helm/files/redacted-fields.json

# Optional: the call to the target. The whole call, connect included, must end within TIMEOUT_SECONDS;
# CONNECT_TIMEOUT_SECONDS must be shorter.
CLUSTER_CLIENT_FORWARDING__CONNECT_TIMEOUT_SECONDS=5
CLUSTER_CLIENT_FORWARDING__TIMEOUT_SECONDS=28

# Optional: send the traces to an OpenTelemetry collector over OTLP/HTTP (in Helm: set by collector.enabled)
CLUSTER_CLIENT_TELEMETRY__EXPORT_ENABLED=false
CLUSTER_CLIENT_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318
