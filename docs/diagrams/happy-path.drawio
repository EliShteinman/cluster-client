<mxfile><diagram name="happy-path" id="happy"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2730" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;The happy path of one call&lt;/b&gt; — what runs when everything works. A red note marks where a failure leaves the path; the rest of a failure is in flow.drawio and docs/failures.md." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2700" height="40" as="geometry"/></mxCell><mxCell id="m" value="&lt;b&gt;Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;redis-enterprise-services&lt;/i&gt;&lt;hr&gt;POST /&lt;br&gt;authorization (NGINX)&lt;br&gt;x-edge-method: GET&lt;br&gt;x-edge-url: https://…/v1/bdbs/7&lt;br&gt;x-target-authorization&lt;br&gt;traceparent&lt;br&gt;body" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="200" height="240" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;① Access&lt;/b&gt;&lt;br&gt;&lt;i&gt;app/routes/target_routes.py · app/access.py&lt;/i&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;require_access(request)&lt;br&gt;  → check_access(header_value)&lt;br&gt;Basic base64(user:password),&lt;br&gt;compared in constant time;&lt;br&gt;runs before the body is read&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="370" y="220" width="360" height="240" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;② Read the request&lt;/b&gt;&lt;br&gt;&lt;i&gt;app/routes/read_request.py · app/models.py&lt;/i&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;read_body(request) → bytes&lt;br&gt;read_target_request(headers, body)&lt;br&gt;→ TargetRequest&lt;br&gt;  method  ← x-edge-method&lt;br&gt;  url     ← x-edge-url&lt;br&gt;  headers ← x-target-*, no prefix&lt;br&gt;  body&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="360" height="240" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;③ Send to the target&lt;/b&gt;&lt;br&gt;&lt;i&gt;app/target/client.py&lt;/i&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;send_to_target(TargetRequest)&lt;br&gt;  call_target → requests.request&lt;br&gt;  in a worker thread,&lt;br&gt;  the whole call ≤ 28 s&lt;br&gt;→ Answer(status, headers, content)&lt;br&gt;  minus content-length… and x-edge-*&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1390" y="220" width="360" height="240" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;④ Check the answer&lt;/b&gt;&lt;br&gt;&lt;i&gt;app/target/response_builder.py · app/rules/&lt;/i&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;build_response(Answer, rules)&lt;br&gt;  read_json_body  standard JSON&lt;br&gt;  remove_fields   ignored-fields.json&lt;br&gt;  validate_body   response-schema.json&lt;br&gt;→ the same Answer, byte for byte,&lt;br&gt;  or re-encoded without ignored fields&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1900" y="220" width="360" height="240" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;⑤ Return&lt;/b&gt;&lt;br&gt;&lt;i&gt;target_endpoint&lt;/i&gt;&lt;hr&gt;Response(status, headers, body):&lt;br&gt;the target&#x27;s answer,&lt;br&gt;+ traceresponse (OpenTelemetry)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="2410" y="220" width="300" height="240" as="geometry"/></mxCell><mxCell id="tgt" value="&lt;b&gt;Target REST API&lt;/b&gt;&lt;br&gt;today Redis Enterprise; any HTTP API:&lt;br&gt;only the three JSON files change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1390" y="60" width="360" height="100" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;ResponseRules&lt;/b&gt;&lt;br&gt;&lt;i&gt;app/rules/response_rules.py · app/state.py&lt;/i&gt;&lt;hr&gt;&lt;font face=&#x27;Courier New&#x27;&gt;loaded once at startup (lifespan),&lt;br&gt;read typed with rules_of(app.state)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1900" y="60" width="360" height="120" as="geometry"/></mxCell><mxCell id="f1" value="✗ wrong or missing authorization → 401 unauthorized" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="370" y="530" width="360" height="64" as="geometry"/></mxCell><mxCell id="f2" value="✗ bad x-edge-* or a refused x-target-* → 400 invalid_request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="880" y="530" width="360" height="64" as="geometry"/></mxCell><mxCell id="f3" value="✗ surely not sent → 502 connection_failed&lt;br&gt;✗ maybe done → 504 timeout&lt;br&gt;✗ refused before sending → 400" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1390" y="530" width="360" height="84" as="geometry"/></mxCell><mxCell id="f4" value="✗ not JSON / too deep / breaks the schema → 502 response_rejected" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1900" y="530" width="360" height="64" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;Failure answer&lt;/b&gt; (app/failures/): its own status + &lt;b&gt;x-edge-error&lt;/b&gt; + an error body that itself passes the firewall; the whole error goes to logs/failures.log. Not drawn here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="680" width="1890" height="56" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;target_endpoint&lt;/b&gt; (app/routes/target_routes.py) is the orchestrator: ① is its route dependency, then it calls ② → ③ → ④ and returns ⑤. FastAPIInstrumentor keeps the manager&#x27;s trace for the whole call." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="2690" height="50" as="geometry"/></mxCell><mxCell id="e101" value="POST /" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=12;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e102" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=12;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e103" value="TargetRequest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=12;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e104" value="Answer&lt;br&gt;(the target&#x27;s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=12;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e105" value="Answer&lt;br&gt;(checked)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=12;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e106" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=12;dashed=0;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="s3" target="tgt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e107" value="reply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=12;dashed=0;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="tgt" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e108" value="rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rules" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryY=0;" edge="1" parent="1" source="f1" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e111" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e112" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryY=0;" edge="1" parent="1" source="f2" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryY=0;" edge="1" parent="1" source="f3" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryY=0;" edge="1" parent="1" source="f4" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>