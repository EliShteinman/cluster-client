# Read by Settings() (docker/entrypoint.py, the container); run_local.py ignores this file.
# Required: who may call the cluster client.
# The manager (and DataPower) send `Authorization: Basic base64(username:password)`; put the plain values here.
CLUSTER_CLIENT_ACCESS__USERNAME=
CLUSTER_CLIENT_ACCESS__PASSWORD=

# Optional: logs (shown with their defaults)
# Lowest level written anywhere; DEBUG also logs every call with its data, passwords included
CLUSTER_CLIENT_LOG__LEVEL=INFO
# Terminal: INFO and up, `line` or `json` (Helm sets json)
CLUSTER_CLIENT_LOG__CONSOLE__LEVEL=INFO
CLUSTER_CLIENT_LOG__CONSOLE__FORMAT=line
# Full DEBUG file logs/app.log: off; to investigate, turn it on and set CLUSTER_CLIENT_LOG__LEVEL=DEBUG
CLUSTER_CLIENT_LOG__FILE__ENABLED=false

# Optional: send the traces to an OpenTelemetry collector (in Helm: set by collector.enabled)
CLUSTER_CLIENT_TELEMETRY__EXPORT_ENABLED=false
CLUSTER_CLIENT_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318

# Every other setting, with its default: the classes in app/config/ (naming rule in README.md, "Configuration")
