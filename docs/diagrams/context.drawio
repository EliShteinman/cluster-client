<mxfile host="drawio"><diagram id="d" name="Context"><mxGraphModel grid="0" page="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;cluster-client in context: one call from the manager to a target behind the firewall&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Manager&lt;/b&gt;&lt;br&gt;redis-enterprise-services, another network&lt;br&gt;&lt;br&gt;&lt;div style=&#x27;text-align:left&#x27;&gt;Owns all business logic.&lt;br&gt;&lt;br&gt;Sends:&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;POST /&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;x-edge-method&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;x-edge-url&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;x-target-*&lt;/font&gt; for the target&lt;br&gt;&amp;nbsp;&amp;nbsp;(e.g. &lt;font face=&quot;Courier New&quot;&gt;x-target-authorization&lt;/font&gt;)&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;traceparent&lt;/font&gt;&lt;br&gt;• the body for the target&lt;br&gt;&lt;br&gt;Reads &lt;font face=&quot;Courier New&quot;&gt;x-edge-error&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;x-edge-target-status&lt;/font&gt;,&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;traceresponse&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="330" height="420" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;NGINX&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&#x27;text-align:left&#x27;&gt;Adds the access header:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;authorization: Basic&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;base64(username:password)&lt;/font&gt;&lt;br&gt;of the manager&#x27;s user for this cluster-client.&lt;br&gt;&lt;br&gt;Passes the other headers and the body on.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="330" height="420" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;DataPower (the firewall)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&#x27;text-align:left&#x27;&gt;Authenticates with the same &lt;font face=&quot;Courier New&quot;&gt;authorization&lt;/font&gt; header and passes it on.&lt;br&gt;&lt;br&gt;Checks &lt;b&gt;every answer body&lt;/b&gt; that comes back against its response schema (&lt;font face=&quot;Courier New&quot;&gt;helm/files/response-schema.json&lt;/font&gt; is that schema, draft-04).&lt;br&gt;&lt;br&gt;A body that breaks it is blocked. It does not read statuses.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="330" height="420" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;cluster-client&lt;/b&gt;&lt;br&gt;this service, inside the network&lt;br&gt;&lt;br&gt;&lt;div style=&#x27;text-align:left&#x27;&gt;Checks &lt;font face=&quot;Courier New&quot;&gt;authorization&lt;/font&gt; (401).&lt;br&gt;Reads &lt;font face=&quot;Courier New&quot;&gt;x-edge-method&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;x-edge-url&lt;/font&gt; (400).&lt;br&gt;Sends every &lt;font face=&quot;Courier New&quot;&gt;x-target-*&lt;/font&gt; header without the prefix, and the body, with &lt;font face=&quot;Courier New&quot;&gt;requests&lt;/font&gt;.&lt;br&gt;&lt;br&gt;On the answer: removes &lt;font face=&quot;Courier New&quot;&gt;ignored-fields.json&lt;/font&gt;, checks &lt;font face=&quot;Courier New&quot;&gt;response-schema.json&lt;/font&gt;.&lt;br&gt;Passes: returns it as is.&lt;br&gt;Breaks it: 502 &lt;font face=&quot;Courier New&quot;&gt;response_rejected&lt;/font&gt;, explained without &lt;font face=&quot;Courier New&quot;&gt;redacted-fields.json&lt;/font&gt;.&lt;br&gt;&lt;br&gt;Every own error body fits the schema.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1460" y="150" width="330" height="420" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Target&lt;/b&gt;&lt;br&gt;any HTTP API&lt;br&gt;&lt;br&gt;&lt;div style=&#x27;text-align:left&#x27;&gt;Today: the Redis Enterprise REST API of a cluster (&lt;font face=&quot;Courier New&quot;&gt;https://cluster:9443/v1/...&lt;/font&gt;).&lt;br&gt;&lt;br&gt;Tomorrow: MongoDB, a metrics endpoint, ... Only the three JSON files change.&lt;br&gt;&lt;br&gt;Gets only the &lt;font face=&quot;Courier New&quot;&gt;x-target-*&lt;/font&gt; headers (prefix removed), the body and &lt;font face=&quot;Courier New&quot;&gt;traceparent&lt;/font&gt;. Never the manager&#x27;s &lt;font face=&quot;Courier New&quot;&gt;authorization&lt;/font&gt;.&lt;br&gt;&lt;br&gt;TLS not verified (internal certificates).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1940" y="150" width="330" height="420" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="HTTPS request" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="355" y="211.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c12" value="answer or 4xx/5xx" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="355" y="471.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="+ authorization" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="835" y="211.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c16" value="same" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="835" y="471.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="authenticated" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1315" y="211.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c20" value="passed the schema" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1315" y="471.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="x-edge-method to x-edge-url" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1795" y="211.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c24" value="answer or own error" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1795" y="471.0" width="140" height="40" as="geometry"/></mxCell><mxCell id="c25" value="Solid arrows: the request. Dashed arrows: the answer. The manager runs in another network; DataPower is the firewall in between. One cluster-client runs in every firewalled network." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1900" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Answers cluster-client writes itself&lt;/b&gt; (always with &lt;font face=&quot;Courier New&quot;&gt;x-edge-error&lt;/font&gt;; never sent to the target):&lt;br&gt;&lt;div style=&#x27;text-align:left&#x27;&gt;400 &lt;font face=&quot;Courier New&quot;&gt;invalid_request&lt;/font&gt; · 401 &lt;font face=&quot;Courier New&quot;&gt;unauthorized&lt;/font&gt; · 404/405 &lt;font face=&quot;Courier New&quot;&gt;invalid_request&lt;/font&gt;&lt;br&gt;502 &lt;font face=&quot;Courier New&quot;&gt;connection_failed&lt;/font&gt; (surely not sent) · 504 &lt;font face=&quot;Courier New&quot;&gt;timeout&lt;/font&gt; (maybe done)&lt;br&gt;502 &lt;font face=&quot;Courier New&quot;&gt;response_rejected&lt;/font&gt; (the target answered; &lt;font face=&quot;Courier New&quot;&gt;x-edge-target-status&lt;/font&gt; holds its status)&lt;br&gt;500 &lt;font face=&quot;Courier New&quot;&gt;internal_error&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1460" y="610" width="810" height="170" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;The contract&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;text-align:left&#x27;&gt;FastAPI &lt;font face=&quot;Courier New&quot;&gt;/docs&lt;/font&gt; of cluster-client is the live contract: request headers, every failure status, its body and headers, all built from the settings.&lt;br&gt;The manager&#x27;s side: &lt;font face=&quot;Courier New&quot;&gt;docs/contracts/edge-service.md&lt;/font&gt; in redis-enterprise-services.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="810" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>